Options -Indexes

RewriteEngine On

# Preserve a single frontend URL shape across local Node and cPanel/PHP hosting.
# /neo/keyquest/... -> proxy.php?path=keyquest/...
RewriteRule ^neo/(.*)$ proxy.php?path=$1 [QSA,L,NE]

# Basic hardening for the recovery harness.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

<FilesMatch "^(recovery-ledger\.jsonl|\.env|package-lock\.json)$">
  Require all denied
</FilesMatch>
